#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "$(uname -s)" == "Darwin" ]]; then
  support="$HOME/Library/Application Support/Harmonizer"
else
  support="${XDG_DATA_HOME:-$HOME/.local/share}/Harmonizer"
fi
if [[ -d "$root/../share/harmonizer/web" ]]; then
  resources="$(cd "$root/../share/harmonizer" && pwd)"
else
  resources="$root"
fi
port="${HARMONIZER_WEB_PORT:-8794}"
url="http://127.0.0.1:$port/"

health_ready() {
  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent "$url"health >/dev/null 2>&1
    return
  fi
  (
    exec 3<>"/dev/tcp/127.0.0.1/$port"
    printf 'GET /health HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n' >&3
    IFS= read -r response <&3
    [[ "$response" == *" 200 "* ]]
  ) 2>/dev/null
}

open_control_surface() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1
  else
    printf 'Open %s in a browser.\n' "$url"
  fi
}

if health_ready; then
  open_control_surface
  exit 0
fi

mkdir -p "$support/web"
cp "$resources/web/index.html" "$support/web/index.html"
cd "$support"

"$root/harmonizer_web" --port "$port" >> "$support/harmonizer.log" 2>&1 &
server_pid=$!
cleanup() {
  if kill -0 "$server_pid" 2>/dev/null; then kill "$server_pid" 2>/dev/null || true; fi
}
trap cleanup INT TERM EXIT

for _attempt in $(seq 1 60); do
  if health_ready; then
    open_control_surface
    wait "$server_pid"
    exit $?
  fi
  sleep 0.1
done

printf 'Harmonizer did not start. See %s\n' "$support/harmonizer.log" >&2
exit 1
